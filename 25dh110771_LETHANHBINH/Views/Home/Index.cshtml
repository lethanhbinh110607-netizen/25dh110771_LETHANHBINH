@{
    ViewBag.Title = "Home Page";
}

<section class="banner">
    <div class="banner-content">
        <h2>SUMMER CLOTHING</h2>
        <p>New in this week for kids, juniors & teens.</p>
        <a href="#" class="btn">Mua sắm ngay</a>
    </div>
</section>
<section class="search-section">
    <h2>Tìm kiếm sản phẩm</h2>
    <div class="search-container">
        <input type="text" id="search-input" placeholder="Nhập từ khóa tìm kiếm (VD: Áo thun, váy)..." />
        <button id="search-button">Tìm kiếm</button>
    </div>
</section>
<nav class="main-menu">
    <ul>
        <li><a href="#">Bé Gái</a></li>
        <li><a href="#">Bé Trai</a></li>
        <li><a href="#">Trẻ Sơ Sinh</a></li>
        <li><a href="#">Giày Dép</a></li>
        <li><a href="#">Phụ Kiện</a></li>
    </ul>
</nav>
<section class="featured-products">
    <h2>NEW ARRIVALS</h2>
    <div class="product-container">
        <div class="product-item">
            <img src="~/Content/Images/sp1.jpg" alt="Váy bé gái" />
            <h3>trang sức 1</h3>
            <p>⭐⭐⭐⭐⭐ (9999+)</p>
            <p class="price">$700</p>
        </div>
        <div class="product-item">
            <img src="~/Content/Images/sp2.jpg" alt="Giày em bé" />.
            <h3>trang sức 2</h3>
            <p>⭐⭐⭐⭐⭐ (9999+)</p>
            <p class="price">$787</p>
        </div>
        <div class="product-item">
            <img src="~/Content/Images/sp3.jpg" alt="Áo thun bé trai" />
            <h3>trang sức 3</h3>
            <p>⭐⭐⭐⭐⭐ (9999+)</p>
            <p class="price">$896</p>
        </div>
    </div>
</section>
<section class="product-list">
    <h2>BEST SALES</h2>
    <ul class="list-container">
        <li class="product-item">
            <img src="~/Content/Images/best1.jfif" alt="Sản phẩm 1" />
            <h3>dây chuyền</h3>
            <p>⭐⭐⭐⭐⭐ (1000+)</p>
            <p class="price">$3000</p>
        </li>
        <li class="product-item">
            <img src="~/Content/Images/best2.jfif" alt="Sản phẩm 2" />
            <h3>đồng hồ</h3>
            <p>⭐⭐⭐⭐⭐ (1000+)</p>
            <p class="price">$1000</p>
        </li>
        <li class="product-item">
            <img src="~/Content/Images/best3.jfif" alt="Sản phẩm 3" />
            <h3>lắc tay </h3>
            <p>⭐⭐⭐⭐⭐ (1000+)</p>
            <p class="price">$2000</p>
        </li>
        <li class="product-item">
            <img src="~/Content/Images/best4.jfif" alt="Sản phẩm 4" />
            <h3>khuyên tai kim cương</h3>
            <p>⭐⭐⭐⭐⭐ (1000+)</p>
            <p class="price">$3000</p>
        </li>
    </ul>
</section>